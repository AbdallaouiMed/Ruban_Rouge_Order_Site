# Copy to .env.local and fill in. Never commit real values.

# Where notifications land (defaults to the address in src/data/bakery.ts)
NOTIFICATION_EMAIL=

# Resend: sender must be on a domain verified in Resend
RESEND_API_KEY=
RESEND_FROM="Ruban Rouge <orders@your-domain.ma>"

# Supabase (server only: the service-role key must NEVER be exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Notion mirror (reuses the owners' existing database columns)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Cloudflare Turnstile (production refuses contact submissions without the secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
